{
  "manifest_version": 3,
  "name": "Polished Hacker News",
  "short_name": "Polished HN",
  "version": "0.0.1",
  "description": "A calm, readable Hacker News: dark themes, clear comment threads, and markers for what you've read and what's new.",
  "minimum_chrome_version": "133",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://news.ycombinator.com/*"],
      "css": ["content.css"],
      "js": ["early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://news.ycombinator.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["https://news.ycombinator.com/*"]
    }
  ]
}
