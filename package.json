{
  "name": "polished-hacker-news",
  "version": "0.0.5",
  "private": true,
  "description": "A calm, readable restyle of Hacker News with threaded comment rails and read tracking.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts --watch",
    "preview": "bun run scripts/preview.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:live": "bun run scripts/check-live.ts",
    "icons": "bun run scripts/icons.ts",
    "zip": "bun run build && bun run scripts/zip.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@types/bun": "^1.4.4",
    "@types/chrome": "^0.3.7",
    "fflate": "^0.8.3",
    "lucide-static": "^1.72.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2"
  }
}
